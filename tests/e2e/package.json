{
  "name": "@miftah/e2e-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "echo e2e-tests-ready",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "devDependencies": {
    "@miftah/contracts": "*",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}

