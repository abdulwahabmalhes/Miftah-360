# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/miftah360?schema=public"

# Server
PORT=3000
NODE_ENV=development

# JWT & Authentication Secrets (Set secure 256-bit keys in production)
JWT_SECRET="dev_jwt_secret_miftah_360_replace_in_production"
JWT_REFRESH_SECRET="dev_jwt_refresh_secret_miftah_360_replace_in_production"

# Redis Cache / Queue (Optional in dev, required in production)
REDIS_URL="redis://localhost:6379"

# S3 Object Storage (Private bucket for vehicle/request/job files)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="me-central-1"
S3_BUCKET="miftah-private-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Optional Admin Bootstrap (Seed script reads these if bootstrapping initial super admin)
# ADMIN_BOOTSTRAP_EMAIL="admin@miftah360.ae"
# ADMIN_BOOTSTRAP_PASSWORD_HASH=""
# ADMIN_BOOTSTRAP_FULLNAME="Super Admin"

